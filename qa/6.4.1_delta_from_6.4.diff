+from pathlib import Path
+import re
+ROOT=Path(__file__).resolve().parents[1]
+checks=[]
+def req(name, ok):
+    checks.append((name, bool(ok)))
+
+state=(ROOT/'pi_firmware/state.py').read_text()
+queue=(ROOT/'pi_firmware/offline_queue.py').read_text()
+ctrl=(ROOT/'pi_firmware/ems_controller.py').read_text()
+api=(ROOT/'pi_firmware/api_client.py').read_text()
+backend=(ROOT/'backend/main.py').read_text()
+setup=(ROOT/'pi_firmware/setup_pi.sh').read_text()
+unit=(ROOT/'pi_firmware/ems-controller.service').read_text()
+frontend_login=(ROOT/'frontend/src/app/login/page.tsx').read_text()
+frontend_admin=(ROOT/'frontend/src/app/admin/page.tsx').read_text()
+frontend_member=(ROOT/'frontend/src/app/member/page.tsx').read_text()
+frontend_super=(ROOT/'frontend/src/app/super-admin/page.tsx').read_text()
+
+req('state remains version 4', 'STATE_VERSION = 4' in state or 'STATE_VERSION=4' in state)
+req('legacy state fields use defaults', 'data.get("used_days", 0)' in state and 'data.get("clicks", 0)' in state)
+req('queue excludes UNKNOWN from claim', "status='DELIVERED'" in queue and "status='UNKNOWN_AFTER_REBOOT'" not in queue[queue.find('def claim_next'):queue.find('def get_interrupted')])
+req('queue supports reboot recovery statuses', all(x in queue for x in ["EXECUTING", "HARDWARE_VERIFIED", "UNKNOWN_AFTER_REBOOT"]))
+req('strict local FSM has no queued->executing', '"queued": {' in backend and '"delivered", "expired"' in backend.split('COMMAND_TRANSITIONS =',1)[1].split('}',1)[0])
+req('delivery lease is 120 seconds', 'COMMAND_DELIVERY_LEASE_SECONDS = 120' in backend)
+req('absolute expiry is 300 seconds', 'COMMAND_EXPIRY_SECONDS = 300' in backend)
+req('HARDWARE_VERIFIED requires positive verification', 'HARDWARE_VERIFIED requires positive hardware verification' in backend)
+req('Pi ACK uses headers', 'X-Device-ID' in api and 'X-API-Key' in api)
+req('Pi ACK JSON does not contain api key', 'payload["key"]' not in api and 'payload["deviceId"]' in api)
+req('retirement avoids destructive device delete', 'DELETE FROM pi_devices' not in backend and "status='RETIRED'" in backend)
+req('retired device cannot be reassigned', 'Retired device cannot be reassigned' in backend)
+req('feedback is capability-clamped in dashboards', 'bool(c["feedback_enabled"]) and bool(dev["feedback_hardware_installed"])' in backend)
+req('firmware download authenticates device key', 'authenticate_pi({}, x_device_id, x_api_key)' in backend)
+req('storage device is explicit and never formatted', 'EMS_DATA_DEVICE' in setup and 'NO FORMAT OPERATION WILL BE PERFORMED' in setup)
+req('data mount root:pi 0770', 'chown root:pi' in setup and 'chmod 0770' in setup)
+req('service runs as pi', 'User=pi' in unit and 'Group=pi' in unit)
+req('service requires EMS data mount', 'RequiresMountsFor=/mnt/ems-data' in unit)
+req('member route is read-only', 'Read-only access' in frontend_member and '/api/admin/pi-command' not in frontend_member)
+req('login routes member separately', 'res.data.role === "member"' in frontend_login and 'router.push("/member")' in frontend_login)
+req('admin route role-guards society admin', 'role !== "society_admin"' in frontend_admin)
+req('super admin route role-guards super admin', 'role !== "super_admin"' in frontend_super)
+req('test credentials are env-driven', 'TEST_USERS' in (ROOT/'frontend/test_system.py').read_text() and '__WRONG_PASSWORD_FOR_TEST__' in (ROOT/'frontend/test_system.py').read_text())
+req('no obsolete storage_health', not (ROOT/'pi_firmware/storage_health.py').exists())
+
+bad=[n for n,ok in checks if not ok]
+for n,ok in checks: print(('PASS' if ok else 'FAIL')+' - '+n)
+print(f'\n{len(checks)-len(bad)}/{len(checks)} checks passed')
+raise SystemExit(1 if bad else 0)
