+            "date": today,
+            "device_serial":
+                self.device_serial,
+            "device":
+                self.device,
+            "baseline_block_reads":
+                current_reads,
+            "baseline_block_writes":
+                current_writes,
+            "logical_writes":
+                dict(
+                    DEFAULT_LOGICAL_COUNTERS
+                ),
+        }
